# Smart MicroGrid Gateway Configuration Template
# Copy this file to .env and adjust values as needed

# Paths (inside Docker containers)
CERTS_PATH=/app/certs
DB_PATH=/app/data/gateway.db

# Provisioner TLS certificate SAN (comma-separated)
# Optional override: setup.sh auto-detects local host IP/DNS and appends them.
# Use these only if you need to force extra hostnames/IPs.
PROVISIONER_CERT_DNS=
PROVISIONER_CERT_IPS=

# Provisioner key options
MIN_RSA_KEY_BITS = 2048
MIN_EC_KEY_BITS = 256
DEFAULT_PEAK_POWER_WATTS = 3000.0

# Broker TLS certificate SAN (comma-separated)
# Optional override: setup.sh auto-detects local host IP/DNS and appends them.
# Use these only if you need to force extra hostnames/IPs.
BROKER_CERT_DNS=
BROKER_CERT_IPS=

# Node-RED client certificate (mTLS to broker)
# If true, setup.sh generates nodered.crt/nodered.key signed by the local CA.
GENERATE_NODERED_CERT=false
# CN for Node-RED client certificate (must match Mosquitto ACL user if enabled)
NODERED_CERT_CN=nodered

# Blockchain client certificate (mTLS to broker)
# If true, setup.sh generates blockchain.crt/blockchain.key signed by the local CA.
GENERATE_BLOCKCHAIN_CERT=false
# CN for Blockchain client certificate (must match Mosquitto ACL user)
BLOCKCHAIN_CERT_CN=blockchain

# Blockchain service MQTT TLS override
BLOCKCHAIN_MQTT_TLS_CA_CERT=/app/certs/ca.crt
BLOCKCHAIN_MQTT_TLS_CERT=/app/certs/blockchain.crt
BLOCKCHAIN_MQTT_TLS_KEY=/app/certs/blockchain.key
BLOCKCHAIN_MQTT_TOPIC=microgrid/transfers

# MQTT Broker
MQTT_BROKER=mosquitto
MQTT_TOPIC=microgrid/production
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_TLS_CA_CERT=/app/certs/ca.crt
MQTT_TLS_CERT=/app/certs/nodered.crt
MQTT_TLS_KEY=/app/certs/nodered.key

# InfluxDB Configuration
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=change-this-token-in-production
INFLUXDB_ORG=microgrid
INFLUXDB_BUCKET=telemetry

# Trust Engine Parameters
TRUST_THRESHOLD_BAN=20.0  # Below this score, device gets banned
TIME_WINDOW=60            # Seconds tolerance for timestamp validation
# Max penalty multiplier for timestamps outside TIME_WINDOW (penalty = TRUST_PENALTY x multiplier)
TEMPORAL_MAX_MULTIPLIER=2.0
# Z-score below which a value is treated as a sudden drop (then checked against the neighbors)
SUDDEN_DROP_Z_SCORE=3.0
# Rolling window (minutes) and minimum samples for the per-node behavioral statistics
STATS_WINDOW_MIN=60
STATS_MIN_SAMPLES=10
# Max seconds credited between two messages when integrating power (W) into energy (Wh)
MAX_ENERGY_INTERVAL_S=300
# Transfers older than this (seconds) are refused by the blockchain relayer
MAX_TRANSFER_AGE_S=300

# Dynamic meteorological tolerance, checked on the energy of 15-minute windows:
# TOL_CLEAR with a clear sky (reliable forecast), up to TOL_CLOUDY with clouds or no forecast
TOL_CLEAR=0.10
TOL_CLOUDY=0.80
# Minimum tolerance band, as a fraction of the peak power (low sun, dawn, dusk)
ABS_TOLERANCE_RATIO=0.02
WINDOW_SECONDS=900

# Ground truth location for the weather check (keep aligned with firmware/simulator)
LATITUDE=
LONGITUDE=
# Timezone of the plant, used by the mathematical fallback when Open-Meteo is unreachable
FALLBACK_TIMEZONE=Europe/Rome

# Physical cap from the sun position (independent from the weather API)
# Sun elevation (degrees) below which it is night; keep aligned with firmware/simulator
NIGHT_ELEVATION_DEG=-2.0
# Production (W) tolerated at night as meter noise; anything above is penalized
NIGHT_MAX_WATT=5.0
# Diffuse + ground-reflected irradiance allowance (W/m2) added to the clear-sky direct beam
MAX_DIFFUSE_WM2=120.0
# Margin over clear sky for the sun shining between clouds
CLOUD_ENHANCEMENT_MARGIN=1.3
# Production never above peak_power x this ratio
PEAK_OVERLOAD_RATIO=1.1

# Provisioner: upper bound for the peak power declared at enrollment (watts)
MAX_PEAK_POWER_WATTS=20000.0
