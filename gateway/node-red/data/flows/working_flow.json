        "name": "function 1",
        "func": "const rawPayload = msg.payload\nlet parsedPayload = rawPayload\n\nif (Buffer.isBuffer(parsedPayload)) {\n    parsedPayload = parsedPayload.toString('utf8')\n}\n\nif (typeof parsedPayload === 'string') {\n    try {\n        parsedPayload = JSON.parse(parsedPayload)\n    } catch (err) {\n        parsedPayload = parsedPayload\n    }\n}\n\nconst payload = (parsedPayload && typeof parsedPayload === 'object') ? parsedPayload : {}\nconst nodeId = payload.node_id ?? payload.nodeId ?? payload.device_id ?? payload.deviceId ?? payload.id\nconst production = payload.production ?? payload.power ?? payload.value\nconst rawTimestamp = payload.timestamp ?? payload.ts ?? payload.time ?? payload.datetime ?? payload.date\n\nlet readableTimestamp = null\nif (rawTimestamp !== undefined && rawTimestamp !== null) {\n    const numeric = Number(rawTimestamp)\n    if (!Number.isNaN(numeric)) {\n        const millis = numeric < 1e12 ? numeric * 1000 : numeric\n        readableTimestamp = new Date(millis).toLocaleString()\n    } else if (typeof rawTimestamp === 'string') {\n        const parsed = new Date(rawTimestamp)\n        if (!Number.isNaN(parsed.getTime())) {\n            readableTimestamp = parsed.toLocaleString()\n        }\n    }\n}\n\nmsg.payload = {\n    node_id: nodeId,\n    production: production,\n    timestamp: readableTimestamp,\n    topic: msg.topic\n}\n\nreturn msg",
