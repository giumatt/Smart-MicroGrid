# Logging
SWARM_DEVICES=100
SWARM_LOG_LEVEL=INFO
SWARM_RUNTIME_DIR=simulation/.runtime

# Enrollment
SWARM_ENROLL_URL=https://localhost:5001/enroll
SWARM_ENROLL_CA_FILE=gateway/certs/ca.crt
SWARM_ALLOW_INSECURE_ENROLL=false
SWARM_STRICT_X509=false
SWARM_ENROLLMENT_TIMEOUT_SECONDS=12
SWARM_ENROLLMENT_RETRY_DELAY_SECONDS=5

# MQTT
SWARM_MQTT_HOST=localhost
SWARM_MQTT_PORT=8883
SWARM_MQTT_TOPIC=microgrid/production
SWARM_INTERVAL_SECONDS=60
SWARM_JITTER_RATIO=0.10
SWARM_RECONNECT_DELAY_SECONDS=5
SWARM_INITIAL_STAGGER_SECONDS=4

# Meteo Forecast API
SWARM_USE_FORECAST_API=true
SWARM_FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
SWARM_FORECAST_LATITUDE=38.3125
SWARM_FORECAST_LONGITUDE=16.0
SWARM_FORECAST_CACHE_SECONDS=1800
SWARM_FORECAST_TIMEOUT_SECONDS=8

# Math-based fallback
SWARM_FALLBACK_SUNRISE_HOUR=6.0
SWARM_FALLBACK_SUNSET_HOUR=18.0
SWARM_FALLBACK_PEAK_IRRADIANCE_WM2=1000.0
